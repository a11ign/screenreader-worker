{
  // Type-checks the `.ts` tests and, through `allowJs`, whatever they import. The root program is `noEmit`: nothing
  // here is built by it, and the package's published files are its `src` as written. `tsconfig.build.json` is what Rslib reads.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "allowJs": true,
    // `js-to-ts` writes `./x.ts` specifiers (ADR 0043, Decision 8); without this the checker refuses them (TS5097). Rslib, not `tsc`, emits.
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
