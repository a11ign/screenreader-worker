{
  "name": "@a11ign/screenreader-worker",
  "version": "0.7.0",
  "description": "Drives a real NVDA screen reader through real navigation on Windows and returns what it announced. The HTTP contract is the API.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./code-version": {
      "types": "./dist/code-version.d.ts",
      "default": "./dist/code-version.mjs"
    },
    "./worker-files": {
      "types": "./dist/worker-files.d.ts",
      "default": "./dist/worker-files.mjs"
    },
    "./capture-pure": {
      "types": "./dist/capture-pure.d.ts",
      "default": "./dist/capture-pure.mjs"
    },
    "./protocol-version": {
      "types": "./dist/protocol-version.d.ts",
      "default": "./dist/protocol-version.mjs"
    },
    "./capture-faults": {
      "types": "./dist/capture-faults.d.ts",
      "default": "./dist/capture-faults.mjs"
    },
    "./package.json": "./package.json",
    "./error-text": {
      "types": "./dist/error-text.d.ts",
      "default": "./dist/error-text.mjs"
    },
    "./auth-flow": {
      "types": "./dist/auth-flow.d.ts",
      "default": "./dist/auth-flow.mjs"
    },
    "./windows-trim": {
      "types": "./dist/windows-trim.d.ts",
      "default": "./dist/windows-trim.mjs"
    }
  },
  "bin": {
    "a11ign-nvda-worker": "./dist/server.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@guidepup/guidepup": "0.31.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11ign/screenreader-worker.git"
  },
  "homepage": "https://github.com/a11ign/screenreader-worker",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "screen-reader",
    "nvda",
    "windows",
    "capture"
  ],
  "devDependencies": {
    "@a11ign/evidence": "0.1.0",
    "@a11ign/toolchain": "0.1.5",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "^10.0.1",
    "@rslib/core": "1.0.3",
    "@rstest/core": "0.12.3",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "yaml": "2.9.1"
  },
  "scripts": {
    "build": "rslib build && node --import tsx scripts/write-code-version.ts",
    "prepack": "pnpm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "rstest run"
  }
}
