{
  "name": "@a11ign/screenreader-worker",
  "version": "0.2.0",
  "description": "Drives a real NVDA screen reader through real navigation on Windows and returns what it announced. The HTTP contract is the API.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./code-version": {
      "types": "./dist/code-version.d.mts",
      "default": "./dist/code-version.mjs"
    },
    "./worker-files": {
      "types": "./dist/worker-files.d.mts",
      "default": "./dist/worker-files.mjs"
    },
    "./capture-pure": {
      "types": "./dist/capture-pure.d.mts",
      "default": "./dist/capture-pure.mjs"
    },
    "./protocol-version": {
      "types": "./dist/protocol-version.d.mts",
      "default": "./dist/protocol-version.mjs"
    },
    "./capture-faults": {
      "types": "./dist/capture-faults.d.mts",
      "default": "./dist/capture-faults.mjs"
    },
    "./package.json": "./package.json",
    "./error-text": {
      "types": "./dist/error-text.d.mts",
      "default": "./dist/error-text.mjs"
    },
    "./auth-flow": {
      "types": "./dist/auth-flow.d.mts",
      "default": "./dist/auth-flow.mjs"
    },
    "./windows-trim": {
      "types": "./dist/windows-trim.d.mts",
      "default": "./dist/windows-trim.mjs"
    }
  },
  "bin": {
    "a11ign-nvda-worker": "./dist/server.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@guidepup/guidepup": "0.31.0"
  },
  "devDependencies": {
    "@a11ign/evidence": "0.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11ign/screenreader-worker.git",
    "directory": "packages/nvda-worker"
  },
  "homepage": "https://github.com/a11ign/screenreader-worker",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "screen-reader",
    "nvda",
    "windows",
    "capture"
  ],
  "scripts": {
    "build": "rslib build",
    "prepack": "rslib build"
  }
}
