    "./capture-pure": "./src/capture-pure.mjs",
    "./protocol-version": "./src/protocol-version.mjs",
    "./capture-faults": "./src/capture-faults.mjs",
    "./package.json": "./package.json",
    "./error-text": "./src/error-text.mjs"
  },
  "bin": {
