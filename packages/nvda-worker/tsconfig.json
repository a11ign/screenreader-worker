{
  // What Rslib reads to write the declarations: the package's own `src`, and never the root program, whose `include` reaches every
  // test and would lay them out under `dist/packages/...`. `tsc` itself emits nothing (Rslib builds; the root `typecheck` checks).
  "extends": "@a11ign/toolchain/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
